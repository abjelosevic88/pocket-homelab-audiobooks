TZ=Europe/Berlin
BASE_URL=https://audio.example.com
# Your Audiobookshelf, as this server reaches it
AUDIOBOOKSHELF_URL=http://audiobookshelf:80
# What a browser opens for "Open in Audiobookshelf" (when AUDIOBOOKSHELF_URL is an internal address)
# AUDIOBOOKSHELF_PUBLIC_URL=https://audiobooks.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# Your own Audiobookshelf account (everyone else connects under Settings → Audiobookshelf):
# an API key made for your account (Audiobookshelf → Settings → API Keys), or your user name and password
# AUDIOBOOKSHELF_TOKEN=
# AUDIOBOOKSHELF_USER=
# AUDIOBOOKSHELF_PASSWORD=
# NOTIFY_URL=http://apprise:8000/notify/audiobooks
# Pocket Core: one sign-in, Audiobookshelf logins per person
# CORE_URL=http://pocket-core:8080
# CORE_REGISTRATION_KEY=
